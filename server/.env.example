PORT=5000
# Local MongoDB or a MongoDB Atlas connection string.
# Run `npm run dev:memory` instead to use a throwaway in-memory database.
MONGO_URI=mongodb://127.0.0.1:27017/docs-reader
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# A document is "expiring soon" when its expiry date is within this many days.
EXPIRY_WARNING_DAYS=30

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
CLIENT_ORIGIN=http://localhost:5173

# Created automatically on first start when the database has no users.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
